.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage

# packaging build output (pip install -e . / pip wheel .)
build/
*.egg-info/

# derived index — rebuildable from SQLite via `omen reindex`
omen_store/chroma/

# ledger DB — decide per-machine whether this is tracked or seeded fresh
*.db
*.sqlite3

.env

# demo_repo/ is its own git repository (constructed history for `omen learn
# --from-git`), nested inside this one. Ignoring only its .git/ keeps its
# *files* tracked normally by the outer repo without turning it into an
# embedded gitlink/submodule.
# A fresh clone has the files but not that history: `python scripts/build_demo_repo.py`
# recreates it.
demo_repo/.git/
